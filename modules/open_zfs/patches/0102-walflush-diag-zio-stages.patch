From: Greg Burd <greg@burd.me>
Subject: [PATCH] zio, dmu: walflush diagnosis, per-stage time of the dmu_sync write pipeline (never upstream)

While dmu_sync() runs zio_nowait() on its block write, time each zio pipeline stage that runs
inline (histogram 35 + stage index) and count taskq hand-offs from inside it (histogram 62).

---
diff --git a/module/zfs/zio.c b/module/zfs/zio.c
--- a/module/zfs/zio.c
+++ b/module/zfs/zio.c
@@ -55,6 +55,14 @@
 #include <sys/dsl_crypt.h>
 #include <cityhash.h>
 
+/* walflush diagnosis (never upstream), patch 0102: per-stage time of the zio
+ * pipeline when run inline from dmu_sync()'s zio_nowait(); stage index
+ * i = highbit64(stage) - 1 goes to histogram 35 + i (OSv walflush_diag.h);
+ * a taskq hand-off from inside it counts in histogram 62. */
+extern uint64_t walflush_diag_now_ns(void);
+extern void walflush_diag_ns(int, uint64_t);
+__thread int walflush_in_dmu_sync;
+
 /*
  * ==========================================================================
  * I/O type descriptions
@@ -2468,6 +2476,8 @@
 		    zio_taskq_member(zio, ZIO_TASKQ_INTERRUPT)) {
 			boolean_t cut = (stage == ZIO_STAGE_VDEV_IO_START) ?
 			    zio_requeue_io_start_cut_in_line : B_FALSE;
+			if (walflush_in_dmu_sync)
+				walflush_diag_ns(62, 0);
 			zio_taskq_dispatch(zio, ZIO_TASKQ_ISSUE, cut);
 			return;
 		}
@@ -2491,7 +2501,11 @@
 		 * (typically the same as this one), or NULL if we should
 		 * stop.
 		 */
-		zio = zio_pipeline[highbit64(stage) - 1](zio);
+		int wfi = highbit64(stage) - 1;
+		uint64_t wft = walflush_in_dmu_sync ? walflush_diag_now_ns() : 0;
+		zio = zio_pipeline[wfi](zio);
+		if (wft != 0)
+			walflush_diag_ns(35 + wfi, walflush_diag_now_ns() - wft);
 
 		if (zio == NULL)
 			return;
diff --git a/module/zfs/dmu.c b/module/zfs/dmu.c
--- a/module/zfs/dmu.c
+++ b/module/zfs/dmu.c
@@ -2273,7 +2273,12 @@
 	uint64_t wfd2 = walflush_diag_now_ns();
 	walflush_diag_ns(32, wfd2 - wfd1);
 	dsa->dsa_wf_issue_ns = wfd2;
-	zio_nowait(wfzio);
+	{
+		extern __thread int walflush_in_dmu_sync;
+		walflush_in_dmu_sync = 1;
+		zio_nowait(wfzio);
+		walflush_in_dmu_sync = 0;
+	}
 	walflush_diag_ns(33, walflush_diag_now_ns() - wfd2);
 
 	return (0);
